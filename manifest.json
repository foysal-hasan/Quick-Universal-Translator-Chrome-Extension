{
  "manifest_version": 3,
  "name": "Quick Universal Translator",
  "description": "Select text and translate from any language to any language with auto language detection.",
  "version": "1.0.2",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage",
    "webRequest",
    "offscreen",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "file:///*"
  ],
  "commands": {
    "translate-selection": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "Translate selected text"
    },
    "print-clipboard-text": {
      "suggested_key": {
        "default": "Alt+C"
      },
      "description": "Print last copied clipboard text"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "background": {
    "service_worker": "background-v2.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles/bubble.css"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_title": "Quick Universal Translator",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  }
}